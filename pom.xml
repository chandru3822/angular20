<!--        </plugin>-->
<!--      </plugins>-->
<!--    </pluginManagement>-->
  </build>
  <repositories>
    <repository>
      <id>maven_central</id>
      <name>Maven Central</name>
      <url>https://repo.maven.apache.org/maven2/</url>
    </repository>
  </repositories>

</project>

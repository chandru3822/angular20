# Create a .env.local with the postgres vars and specify the file in your up command: `docker-compose --env-file ./.env.local up`

PGHOST=localhost
PGPORT=5433
PGDATABASE=
PGUSER=
PGPASSWORD=
SWAGGER_ENABLED=true

LOANPAL_ACCESS_KEY_ID=***REMOVED***
LOANPAL_SECRET_ACCESS_KEY=***REMOVED***
AWS_SIGN_PROXY_TARGETHOST=api.loanpal.com
AWS_SIGN_PROXY_PROVIDER=execute-api
AWS_SIGN_PROXY_REGION=us-west-2

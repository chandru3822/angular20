{
    "family": "prometheus-td",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::480699501737:role/AmazonECSTasksSecretsManagerRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "prometheus-container",
            "image": "480699501737.dkr.ecr.us-east-1.amazonaws.com/prometheus-repo:latest",
            "portMappings": [
                {
                    "containerPort": 9090,
                    "hostPort": 9090,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "HELLO_WORLD",
                    "value": "hello"
                },
                {
                    "name" : "_LOREM_IPSUM_OPTIONS",
                    "value" : "-XX:MaxRAMPercentage=75.0"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/prometheus",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "prometheus-"
                }
            },
            "essential": true
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}

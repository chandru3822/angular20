{
    "family": "albatross-cron-stage",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::480699501737:role/AmazonECSTasksSecretsManagerRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "albatross-cron-stage-container",
            "image": "480699501737.dkr.ecr.us-east-1.amazonaws.com/albatross-repo:latest",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "stage"
                },
                {
                    "name" : "_JAVA_OPTIONS",
                    "value" : "-XX:MaxRAMPercentage=75.0"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/albatross-cron-stage",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-cron-stage"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "4096"
}

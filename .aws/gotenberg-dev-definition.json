{
    "family": "albatross-html2pdf-dev-td",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::480699501737:role/AmazonECSTasksSecretsManagerRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "albatross-html2pdf-container",
            "image": "gotenberg/gotenberg:7",
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/albatross-html2pdf-dev-td",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-albatross-html2pdf-dev-"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "4096"
}

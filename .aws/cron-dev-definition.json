{
    "family": "albatross-cron-dev-td",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::480699501737:role/AmazonECSTasksSecretsManagerRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "albatross-cron-dev-container",
            "image": "480699501737.dkr.ecr.us-east-1.amazonaws.com/albatross-repo:latest",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
           "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "cron,dev"
                },
                {
                    "name" : "_JAVA_OPTIONS",
                    "value" : "-XX:MaxRAMPercentage=75.0"
                }
            ],

            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/albatross-cron-dev",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-albatross-cron-dev-"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "4096"
}

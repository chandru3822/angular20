{
    "family": "albatross-fargate-cluster",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::480699501737:role/AmazonECSTasksSecretsManagerRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "grafana-container",
            "image": "480699501737.dkr.ecr.us-east-1.amazonaws.com/albatross-dev-repo:latest",
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "dev"
                },
                {
                    "name" : "_JAVA_OPTIONS",
                    "value" : "-XX:MaxRAMPercentage=75.0"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/grafana-fargate",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "dashboard"
                }
            },
            "essential": true
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}

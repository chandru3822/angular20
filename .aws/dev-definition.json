{
    "family": "albatross-dev-td",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::480699501737:role/AmazonECSTasksSecretsManagerRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "albatross-dev-container",
            "image": "480699501737.dkr.ecr.us-east-1.amazonaws.com/albatross-dev-repo:latest",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "dev"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/albatross-dev",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-albatross-dev-"
                }
            },
            "memory": 2048,
            "cpu": 10,
            "essential": true
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "4096"
}

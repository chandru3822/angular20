{
    "family": "br-stage",
    "executionRoleArn": "arn:aws:iam::480699501737:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "br-stage",
            "image": "480699501737.dkr.ecr.us-east-1.amazonaws.com/br-stage-repo:latest",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": {
                "SPRING_PROFILES_ACTIVE": "stage"
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/br-stage",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-br-stage"
                }
            },
            "memory": 500,
            "cpu": 10,
            "essential": true
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024"
}
